+const upgradeStep = (id, index, fromTier) => ({ type: 'upgrade', id, index, fromTier, cost: TIER_COSTS[id][fromTier] });
+const PLAN = [
+  buildStep('sluice', 0, SLUICES), buildStep('sentry_beacon', 0, BEACONS),

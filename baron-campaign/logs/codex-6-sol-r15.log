+  return [...prefix, ...blastOrders(view)].slice(0, 32);
+}
+
+function selfCheck() {
+  const view = { now: { wave: 10, hero: { hp: 100, maxHp: 100 }, pendingOffer: [{ id: 'spring_heels' }, { id: 'heavy_spark' }] } };

+    const left = map.get(a.id); const right = map.get(b.id);
+    return Math.hypot((left?.x ?? 999) - prospector.x, (left?.z ?? 999) - prospector.z)
+      - Math.hypot((right?.x ?? 999) - prospector.x, (right?.z ?? 999) - prospector.z);
+  })[0];

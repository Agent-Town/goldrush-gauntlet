const TURRETS = [{ x: -6, z: 12 }, { x: -2, z: 12 }, { x: 2, z: 12 }, { x: 6, z: 12 }];
const BEACONS = [{ x: 0, z: 15 }, { x: -6, z: 14 }, { x: -4, z: 15 }, { x: 2, z: 15 }, { x: 3, z: 14 }, { x: 3, z: 16 }];
const PALISADES = [{ x: 0, z: 11 }, { x: -10, z: 11 }, { x: 10, z: 11 }];

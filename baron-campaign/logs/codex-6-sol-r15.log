+      child.stdin.write(`${JSON.stringify(orders)}\n`);
+    } else {
+      outcome = message;
+      transcript.write(`${JSON.stringify({ type: 'outcome', outcome: message })}\n`);
+    }
+  }
+});
+child.stderr.pipe(errors);
+
+child.on('close', async (code) => {

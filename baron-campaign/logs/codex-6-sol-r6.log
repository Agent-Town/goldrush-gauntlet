+  ...SLUICES.flatMap((_, index) => [upgradeStep('sluice', index, 1), upgradeStep('sluice', index, 2)]),
+  buildStep('sentry_beacon', 1, BEACONS), buildStep('sentry_beacon', 2, BEACONS),
+  ...TURRETS.map((_, index) => upgradeStep('turret', index, 1)),

      ? Math.max(secureWave, this.manifest.twist.baron.wave) + BOSS_GRACE_WAVES
      : secureWave + 2;
    const maxTicks = Math.ceil((finalWave * Balance.waves.waveInterval) / STEP_SECONDS);

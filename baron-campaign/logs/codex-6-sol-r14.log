+  assert.equal(orders.length, 28);
+  assert.ok(orders.slice(0, 26).every(({ verb, weapon }) => verb === 'SET_WEAPON' && weapon === 'rig'));
+  assert.deepEqual(orders.at(-1).pos, { x: 0, z: 20 });

+    if (harvest.length) return [...prefix, ...harvest].slice(0, 32);
+  }
+
+  const goal = phaseGoals(view)[0];
+  if (goal && view.now.gold >= goal.cost) return [...prefix, { verb: 'MOVE_TO', pos: goal.pos }, goal.order, ...blastOrders(view)].slice(0, 32);

+    powder_charge: 113, quick_fuse: 111, beacon_dynamo: 109, chain_spark_arc: 106,
+    beacon_handoff: 104, tinkers_plating: view.now.wave >= 16 || hpRatio < 0.72 ? 145 : 101,

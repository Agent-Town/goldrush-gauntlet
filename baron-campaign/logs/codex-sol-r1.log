      if (def.minWave !== undefined && this.options.getWave() < def.minWave) return false;
      if (def.id === 'beacon_dynamo' && beaconCount <= 0) return false;
      return (this.stacksValue[def.id] ?? 0) < def.maxStacks;
    });
  }


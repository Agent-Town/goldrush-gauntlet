export type EffectiveStats = {
  fireRateMult: number;
  damageMult: number;
  rangeMult: number;
  boltSpeedMult: number;
  volleyBonus: number;
  maxHpBonus: number;
  moveSpeedMult: number;
  panTickMult: number;

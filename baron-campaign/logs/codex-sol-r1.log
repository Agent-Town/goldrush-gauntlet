+#!/usr/bin/env node
+
+import assert from 'node:assert/strict';
+import { createWriteStream } from 'node:fs';
+import { rename, writeFile } from 'node:fs/promises';
+import { spawn } from 'node:child_process';
+
+const ROOT = new URL('.', import.meta.url);
+const SLUICES = [{ x: -4, z: 7 }, { x: 0, z: 7 }, { x: 4, z: 7 }];
+const TURRETS = [{ x: -6, z: 13 }, { x: -2, z: 13 }, { x: 2, z: 13 }, { x: 6, z: 13 }];
+const PALISADES = [
+  { x: -8, z: 11 }, { x: 8, z: 11 },
+  { x: 0, z: 11 }, { x: -4, z: 11 }, { x: 4, z: 11 }, { x: -12, z: 11 }, { x: 12, z: 11 },
+];
+const STOCKPILES = [{ x: -8, z: 16 }, { x: 8, z: 16 }];
+const HOLD = { x: 0, z: 12 };
+const COSTS = { sluice: 40, turret: [50, 70, 95, 125], stockpile: 60, palisade: 10 };
+const TIER_COSTS = { sluice: [0, 120, 240], turret: [0, 150, 300] };
+const UPGRADE_PRIORITY = [
+  'heavy_spark', 'split_spark', 'double_tap_coil', 'chain_spark_arc', 'spark_pressure_ring',
+  'powder_charge', 'quick_fuse', 'wide_ring', 'long_resonator', 'tinkers_plating',
+  'spring_heels', 'prospectors_luck', 'beacon_dynamo', 'sharpen', 'field_dressing', 'assay_bonus',
+];
+
+function pickUpgrade(offer, hero) {
+  const dressing = offer.find(({ id }) => id === 'field_dressing');
+  if (dressing && hero.hp < hero.maxHp * 0.7) return dressing;
+  return [...offer].sort((a, b) => {
+    const rank = (id) => {
+      const index = UPGRADE_PRIORITY.indexOf(id);
+      return index < 0 ? UPGRADE_PRIORITY.length : index;
+    };
+    return rank(a.id) - rank(b.id);
+  })[0];
+}
+
+function buildGoal(view, id, positions) {
+  const built = view.now.works.byKind[id] ?? 0;
+  if (built >= positions.length) return null;
+  const cost = Array.isArray(COSTS[id]) ? COSTS[id][built] : COSTS[id];
+  return { cost, pos: positions[built], order: { verb: 'BUILD', what: id, where: positions[built], when: { goldGte: cost } } };
+}
+
+function upgradeGoal(view, id, maxTier = 3) {
+  const entry = view.now.works.entries
+    .filter((work) => work.id === id && !work.wrecked && work.tier < maxTier)
+    .sort((a, b) => a.tier - b.tier || a.index - b.index)[0];
+  if (!entry) return null;
+  return {
+    cost: TIER_COSTS[id][entry.tier],
+    pos: entry.position,
+    order: { verb: 'CONTEXT_ACTION', action: 'upgrade', target: { id, index: entry.index } },
+  };
+}
+
+function nextGoal(view) {
+  const desiredPalisades = view.now.wave >= 18 ? PALISADES.length : view.now.wave >= 12 ? 2 : 0;
+  if ((view.now.works.byKind.palisade ?? 0) < desiredPalisades) {
+    const decoy = buildGoal(view, 'palisade', PALISADES);
+    if (decoy) return decoy;
+  }
+
+  const sluices = view.now.works.byKind.sluice ?? 0;
+  const turrets = view.now.works.byKind.turret ?? 0;
+  if (sluices === 0) return buildGoal(view, 'sluice', SLUICES);
+  if (turrets === 0) return buildGoal(view, 'turret', TURRETS);
+  if (sluices < 3) return buildGoal(view, 'sluice', SLUICES);
+  if (turrets < 2) return buildGoal(view, 'turret', TURRETS);
+  if ((view.now.works.byKind.stockpile ?? 0) < 2) return buildGoal(view, 'stockpile', STOCKPILES);
+  if (turrets < 4) return buildGoal(view, 'turret', TURRETS);
+
+  return upgradeGoal(view, 'sluice', 2)
+    ?? upgradeGoal(view, 'turret', 2)
+    ?? upgradeGoal(view, 'sluice')
+    ?? upgradeGoal(view, 'turret');
+}
+
+function blastOrders(view) {
+  if (view.now.blastReadyInMs !== 0 || view.now.threats.alive === 0) return [];
+  return [{ verb: 'SET_WEAPON', weapon: 'blast' }, { verb: 'SET_WEAPON', weapon: 'rig' }];
+}
+
+function moneyOrders(view) {
+  const orders = [];
+  const seams = view.now.seams
+    .filter(({ active, remaining }) => active && remaining > 0)
+    .sort((a, b) => b.remaining - a.remaining);
+  for (const seam of seams) {
+    for (let repeat = 0; repeat < 6 && orders.length < 28; repeat += 1) {
+      orders.push({ verb: 'HARVEST', seam: seam.id });
+    }
+  }
+  return orders;
+}
+
+function ordersFor(view) {
+  if (view.now.pendingSecure) return [{ verb: 'SECURE_CHOICE', choice: 'bank' }];
+  if (view.now.pendingOffer?.length) return [{ verb: 'PICK_UPGRADE', id: pickUpgrade(view.now.pendingOffer, view.now.hero).id }];
+
+  const orders = blastOrders(view);
+  const repair = view.now.wave < 18 && view.now.gold >= 50 && view.now.works.entries.some(
+    ({ hp, maxHp, wrecked }) => wrecked || (maxHp > 0 && hp / maxHp < 0.5),
+  );
+  const goal = repair ? null : nextGoal(view);
+  if (repair) orders.push({ verb: 'REPAIR_UNDER', pct: 50 });
+  else if (goal && view.now.gold >= goal.cost) orders.push({ verb: 'MOVE_TO', pos: goal.pos }, goal.order);
+  orders.push(...moneyOrders(view));
+  orders.push({ verb: 'SET_WEAPON', weapon: 'rig' }, { verb: 'HOLD', pos: HOLD });
+  return orders.slice(0, 32);
+}
+
+function selfCheck() {
+  assert.equal(pickUpgrade([{ id: 'spring_heels' }, { id: 'heavy_spark' }], { hp: 100, maxHp: 100 }).id, 'heavy_spark');
+  assert.equal(pickUpgrade([{ id: 'heavy_spark' }, { id: 'field_dressing' }], { hp: 60, maxHp: 100 }).id, 'field_dressing');
+  assert.deepEqual(blastOrders({ now: { blastReadyInMs: 0, threats: { alive: 1 } } }), [
+    { verb: 'SET_WEAPON', weapon: 'blast' }, { verb: 'SET_WEAPON', weapon: 'rig' },
+  ]);
+  console.log('player self-check: ok');
+}
+
+if (process.argv.includes('--self-check')) {
+  selfCheck();
+  process.exit(0);
+}
+
+const run = Number(process.argv[2] ?? 1);
+if (!Number.isInteger(run) || run < 1 || run > 6) throw new Error('run must be an integer from 1 to 6');
+
+const transcriptPath = new URL(`run-${run}.jsonl`, ROOT);
+const stderrPath = new URL(`run-${run}.stderr.log`, ROOT);
+const tapePath = `run-${run}-tape.json`;
+const transcript = createWriteStream(transcriptPath);
+const errors = createWriteStream(stderrPath);
+const child = spawn(process.execPath, [
+  'scripts/gr-sim.mjs', '--contract', 'e1-baron', '--seed', 'e1-baron-01', '--tape', tapePath,
+], { cwd: ROOT, stdio: ['pipe', 'pipe', 'pipe'] });
+
+let buffer = '';
+let outcome;
+child.stdout.on('data', (chunk) => {
+  transcript.write(chunk);
+  buffer += chunk;
+  let newline;
+  while ((newline = buffer.indexOf('\n')) >= 0) {
+    const line = buffer.slice(0, newline);
+    buffer = buffer.slice(newline + 1);
+    if (!line) continue;
+    const message = JSON.parse(line);
+    if (message.schema === 'goldrush.view.v1') child.stdin.write(`${JSON.stringify(ordersFor(message))}\n`);
+    else outcome = message;
+  }
+});
+child.stderr.pipe(errors);
+
+child.on('close', async (code) => {
+  transcript.end();
+  errors.end();
+  if (code !== 0 || !outcome) throw new Error(`gr-sim exited ${code} without an outcome`);
+  const result = { ...outcome, runsSoFar: run, player: 'player.mjs', tape: tapePath };
+  const temporary = new URL('outcome.json.tmp', ROOT);
+  await writeFile(temporary, `${JSON.stringify(result, null, 2)}\n`);
+  await rename(temporary, new URL('outcome.json', ROOT));
+  console.log(JSON.stringify(result));
+});


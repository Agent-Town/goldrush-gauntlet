+}
+
+function phaseGoal(view) {
+  if (view.now.wave >= 19) {
+    const index = view.now.works.byKind.palisade ?? 0;
+    return index < PALISADES.length
+      ? { cost: COSTS.palisade, pos: PALISADES[index], order: { verb: 'BUILD', what: 'palisade', where: PALISADES[index], when: { goldGte: COSTS.palisade } } }
+      : null;

    delta: number,
    heroPosition: THREE.Vector3,
    thiefContext?: ThiefUpdateContext,
    wreckerContext?: WreckerUpdateContext,
  ): THREE.Vector3 {
    const thiefTarget = this.updateThief(delta, thiefContext);

   211	const masteryOfferIds = new Set(masteryConversionRules.flatMap((rule) => rule.offers));
   212	
   213	export function isUpgradeId(id: string): id is UpgradeId {
   214	  return id in upgradeDefById;
   215	}
   216	
   217	export function applyUpgradeBudgetsFromBalance(): void {
   218	  (upgradeDefById.double_tap_coil as { maxStacks: number }).maxStacks = Balance.upgrades.doubleTapCoilMaxStacks;
   219	}
   220	
   221	export function upgradeEffect(def: UpgradeDef): string {
   222	  const deltas: UpgradeDeltas = def.deltas;
   223	  const parts: string[] = [];
   224	  if (deltas.fireRateMult !== undefined) parts.push(`+${percent(deltas.fireRateMult)}% fire rate`);
   225	  if (deltas.damageMult !== undefined) parts.push(`+${percent(deltas.damageMult)}% spark damage`);
   226	  if (deltas.rangeMult !== undefined) parts.push(`+${percent(deltas.rangeMult)}% range`);
   227	  if (deltas.boltSpeedMult !== undefined) parts.push(`+${percent(deltas.boltSpeedMult)}% bolt speed`);
   228	  if (deltas.volleyBonus !== undefined) parts.push(`+${deltas.volleyBonus} spark per volley`);
   229	  if (deltas.maxHpBonus !== undefined) parts.push(`+${deltas.maxHpBonus} max HP`);
   230	  if (deltas.heal !== undefined) parts.push(`heals ${deltas.heal}`);
   231	  if (deltas.goldGrant !== undefined) parts.push(`+${deltas.goldGrant} gold now`);
   232	  if (deltas.moveSpeedMult !== undefined) parts.push(`+${percent(deltas.moveSpeedMult)}% move speed`);
   233	  if (deltas.panTickMult !== undefined) {
   234	    parts.push(
   235	      deltas.panTickMult < 0
   236	        ? `${percent(Math.abs(deltas.panTickMult))}% faster panning`
   237	        : `${percent(deltas.panTickMult)}% slower panning`,
   238	    );
   239	  }
   240	  if (deltas.seamCapacityBonus !== undefined) parts.push(`+${deltas.seamCapacityBonus} gold per seam`);
   241	  if (deltas.seamRespawnReduction !== undefined) parts.push(`-${deltas.seamRespawnReduction}s seam respawn`);
   242	  if (deltas.stockpileCapBonus !== undefined) parts.push(`+${deltas.stockpileCapBonus} stockpile room`);
   243	  if (deltas.beaconFireRateMult !== undefined) parts.push(`+${percent(deltas.beaconFireRateMult)}% beacon fire rate`);
   244	  if (deltas.blastDamageMult !== undefined) parts.push(`+${percent(deltas.blastDamageMult)}% blast damage`);
   245	  if (deltas.blastRadiusMult !== undefined) parts.push(`+${percent(deltas.blastRadiusMult)}% blast radius`);
   246	  if (deltas.blastCooldownMult !== undefined) parts.push(`${percent(Math.abs(deltas.blastCooldownMult))}% faster blast fuse`);
   247	  if (deltas.agentPolicySlots !== undefined) parts.push(`+${deltas.agentPolicySlots} Prospector policy slot this run`);
   248	  return parts.join(', ');
   249	}
   250	
   251	export function isUpgradeUnlocked(def: UpgradeDef, hasResearchNode: (id: string) => boolean): boolean {
   252	  return !('familyGate' in def) || !def.familyGate || hasResearchNode(def.familyGate);
   253	}
   254	
   255	export function isMasteryConversionUnlocked(
   256	  def: UpgradeDef,
   257	  stacks: Partial<Record<string, number>>,
   258	  hasResearchNode?: (id: string) => boolean,
   259	): boolean {
   260	  if (!masteryOfferIds.has(def.id)) return true;
   261	  if (!hasResearchNode) return false;
   262	  return masteryConversionRules.some(
   263	    (rule) => rule.offers.includes(def.id) && isUpgradeFamilyMaxed(rule.whenFamilyMaxed, stacks, hasResearchNode),
   264	  );
   265	}
   266	
   267	export function upgradeFamilyId(def: UpgradeDef): string {
   268	  return def.familyId ?? def.iconFamily;
   269	}
   270	
   271	export function isUpgradeFamilyMaxed(
   272	  familyId: string,
   273	  stacks: Partial<Record<string, number>>,
   274	  hasResearchNode: (id: string) => boolean,
   275	): boolean {
   276	  const family = upgradeDefs.filter(
   277	    (def) =>
   278	      upgradeFamilyId(def) === familyId &&
   279	      !isFiller(def) &&
   280	      !masteryOfferIds.has(def.id) &&
   281	      isUpgradeUnlocked(def, hasResearchNode),
   282	  );
   283	  return family.length > 0 && family.every((def) => (stacks[def.id] ?? 0) >= def.maxStacks);
   284	}
   285	
   286	export function resolveFiller(def: UpgradeDef, ctx: { wave: number; maxHp: number }): ResolvedFiller {
   287	  if (def.id === 'assay_bonus') {
   288	    const goldGrant = Balance.upgrades.assayGoldPerWave * Math.max(1, ctx.wave);
   289	    return { goldGrant, effectText: `+${goldGrant} gold now` };
   290	  }
   291	  if (def.id === 'field_dressing') {
   292	    const heal = Math.round(Balance.upgrades.fieldDressingHealFrac * ctx.maxHp);
   293	    return { heal, effectText: `heals ${heal}` };
   294	  }
   295	  return { effectText: upgradeEffect(def) };
   296	}
   297	
   298	function percent(value: number): number {
   299	  return Math.round(value * 100);
   300	}
   301	
   302	function isFiller(def: UpgradeDef): boolean {
   303	  return def.filler === true;
   304	}
   305	
   306	function loadCraftedUpgradeDefs(): UpgradeDef[] {
   307	  const files =
   308	    typeof import.meta.env === 'object'
   309	      ? import.meta.glob<CraftingQueueApproved>('../../assets/crafting-queue/approved/*.json', {
   310	          eager: true,
   311	          import: 'default',
   312	        })
   313	      : {};
   314	  const byId = new Map<string, UpgradeDef>();
   315	  for (const value of Object.keys(files).sort().map((path) => files[path])) {
   316	    const entry = parseApprovedQueueEntry(value);
   317	    const card = entry?.item.family ? craftedItemCard(entry) : null;
   318	    if (card) byId.set(card.id, card);
   319	  }
   320	  return [...byId.values()];
   321	}
   322	
   323	function craftedItemCard(entry: CraftingQueueApproved): UpgradeDef {
   324	  const item: CraftedItemDef = entry.item;
   325	  const family = item.family!;
   326	  return {
   327	    id: `crafted_${item.id}`,
   328	    name: item.name,
   329	    description: item.blurb,
   330	    iconFamily: family,
   331	    familyId: `crafted_${family}`,
   332	    familyGate: 'pattern_library',
   333	    crafted: true,
   334	    craftedProfile: entry.request.profile,
   335	    maxStacks: 1,
   336	    weight: 0.85,
   337	    deltas: { ...item.stats },
   338	  };
   339	}
   340	
   341	export function craftedOfferLimit(): number {
   342	  return craftedOfferCap;
   343	}


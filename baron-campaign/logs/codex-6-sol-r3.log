   134	
   135	  submit(input: unknown, at?: number): StandingOrdersSubmission {
   136	    const state = this.state(at);
   137	    const eventAt = at ?? state.timeAlive;
   138	    const validated = validateStandingOrders(input);
   139	    if (!validated.ok) {
   140	      this.append({ at: eventAt, type: 'orders_rejected', reason: validated.message });
   141	      return { ok: false, reason: 'INVALID_ARGS', message: validated.message };
   142	    }
   143	
   144	    const invalidPick = validated.orders.find(
   145	      (order) => order.verb === 'PICK_UPGRADE' && !state.pendingOffer.includes(order.id),
   146	    );
   147	    if (invalidPick?.verb === 'PICK_UPGRADE') {
   148	      const message = `PICK_UPGRADE requires a live offered id; "${invalidPick.id}" is not available.`;
   149	      this.append({ at: eventAt, type: 'orders_rejected', reason: message });
   150	      return { ok: false, reason: 'INVALID_ARGS', message };
   151	    }
   152	    if (state.pendingSecure && (validated.orders.length !== 1 || validated.orders[0]?.verb !== 'SECURE_CHOICE')) {
   153	      const message = 'Only one SECURE_CHOICE is accepted while the secure window is open.';
   154	      this.append({ at: eventAt, type: 'orders_rejected', reason: message });
   155	      return { ok: false, reason: 'INVALID_ARGS', message };
   156	    }
   157	    if (validated.orders.some((order) => order.verb === 'SECURE_CHOICE') && !state.pendingSecure) {
   158	      const message = 'SECURE_CHOICE requires a live secure window.';
   159	      this.append({ at: eventAt, type: 'orders_rejected', reason: message });
   160	      return { ok: false, reason: 'INVALID_ARGS', message };
   161	    }
   162	
   163	    const level = this.surface.permissionLevel();
   164	    const blocked = validated.orders
   165	      .map((order) => ({ order, denial: permissionDenial(order, state, level) }))
   166	      .find((entry) => entry.denial);
   167	    if (blocked) {
   168	      this.append({ at: eventAt, type: 'orders_rejected', reason: blocked.denial! });
   169	      return {
   170	        ok: false,
   171	        reason: 'PERMISSION_DENIED',
   172	        message: blocked.denial!,
   173	        requiredLevel: requiredLevel(blocked.order),
   174	      };
   175	    }
   176	
   177	    this.submission += 1;
   178	    this.records = validated.orders.map((order, index) => ({
   179	      id: `orders-${this.submission}-${index + 1}`,
   180	      order,
   181	      status: 'pending',
   182	    }));
   183	    this.needsRiderValue = false;
   184	    this.append({ at: eventAt, type: 'orders_replaced', orders: copyRecords(this.records) });
   185	    return { ok: true, count: this.records.length };
   186	  }
   187	
   188	  tick(at: number, actor: AgentVec2): StandingOrderTickResult {
   189	    const state = this.state(at, this.records.some((record) => record.status === 'pending' || record.status === 'active'));
   190	    this.detectSurprises(state, at);
   191	
   192	    for (const record of this.records) {
   193	      if (record.status === 'done' || record.status === 'failed') continue;
   194	      if (state.pendingSecure && record.order.verb !== 'SECURE_CHOICE') continue;
   195	      const level = this.surface.permissionLevel();
   196	      const denial = permissionDenial(record.order, state, level);
   197	      if (denial) {
   198	        this.fail(record, `PERMISSION_DENIED: ${denial}`, at);
   199	        return {};
   200	      }
   201	
   202	      const result = this.execute(record, state, actor, at);
   203	      if (result) return result;
   204	    }
   205	    return {};
   206	  }

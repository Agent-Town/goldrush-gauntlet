+    ...Array.from({ length: waits }, () => ({ verb: 'SET_WEAPON', weapon: 'rig' })),
+    { verb: 'BLAST_AT', pos },
+    { verb: 'BLAST_AT', pos },
+  ];
+}
+
+function moneyOrders(view) {
+  if (view.now.gold >= 480) return [];
+  const locations = new Map(view.stablePrefix.map.seams.map((seam) => [seam.id, seam]));

  1452	  private fundMegaproject(): { ok: true } | { ok: false; reason: string } {
  1453	    const manifest = this.megaprojectManifest;
  1454	    const project = this.megaprojectProject;
  1455	    if (!manifest || !project || !this.megaprojectUnlocked || megaprojectComplete(manifest, project) || project.funded) {
  1456	      return { ok: false, reason: 'REJECTED: no megaproject stage can be funded.' };
  1457	    }
  1458	    const { x, z, w, d } = manifest.siteFootprint;
  1459	    const dx = Math.max(Math.abs(this.prospector.position.x - x) - w * 0.5, 0);
  1460	    const dz = Math.max(Math.abs(this.prospector.position.z - z) - d * 0.5, 0);
  1461	    if (dx * dx + dz * dz > 2.2 * 2.2) return { ok: false, reason: 'OUT_OF_REACH: the Prospector is not at the megaproject site.' };
  1462	    const cost = megaprojectStageCost(manifest, project);
  1463	    const spent = this.economy.apply(this.economyEvent({
  1464	      type: 'gold_spent',
  1465	      sink: `megaproject_${manifest.id}`,
  1466	      amount: cost,
  1467	    }));
  1468	    if (!spent.ok) return { ok: false, reason: `INSUFFICIENT_GOLD: funding requires ${cost} gold.` };
  1469	    if (!fundMegaprojectStage(manifest, project)) return { ok: false, reason: 'REJECTED: megaproject funding failed.' };
  1470	    this.replayEvents.push({ type: 'context_action', at: round(this.timeAlive), action: 'fund', cost });
  1471	    return { ok: true };
  1472	  }

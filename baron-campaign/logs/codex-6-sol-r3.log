  1061	  private baronRocketMeleeSuppressed(baron: (typeof this.enemies.all)[number]): boolean {
  1062	    const heroReach = baron.hitRadius + Balance.hero.radius + 0.35;
  1063	    if (baron.position.distanceToSquared(this.hero.group.position) <= heroReach * heroReach) return true;
  1064	    const building = this.targeting.nearestBuilding(baron.position);
  1065	    if (!building) return false;
  1066	    const dx = Math.max(0, Math.abs(baron.position.x - building.position.x) - building.halfX);
  1067	    const dz = Math.max(0, Math.abs(baron.position.z - building.position.z) - building.halfZ);
  1068	    const reach = Balance.wreck.reach * Math.max(1, baron.visualScale) + 0.35;
  1069	    return dx * dx + dz * dz <= reach * reach;
  1070	  }

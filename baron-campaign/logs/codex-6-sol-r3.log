   340	      this.status(record, 'active', at);
   341	      const result = this.contextAction?.(order) ?? { ok: false as const, reason: 'CONTEXT_ACTION is unavailable.' };
   342	      if (result.ok) this.status(record, 'done', at);
   343	      else this.fail(record, result.reason, at);

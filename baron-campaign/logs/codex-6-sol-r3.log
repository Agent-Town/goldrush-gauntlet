   319	      if (distance(actor, point) > Balance.agent.arriveRadius || state.actorMoving) return { movement: point };
   320	      const receipt = this.surface.tools.pan_at('seam' in order ? order.seam : `sluice-${order.sluice + 1}`);
   321	      return this.finishAction(record, receipt, point, at);
   322	    }
   323	
   324	    if (order.verb === 'PICK_UPGRADE') {
   325	      this.status(record, 'active', at);
   326	      if (!this.pickUpgrade?.(order.id)) this.fail(record, `INVALID_TARGET: ${order.id} is no longer offered.`, at);
   327	      else this.status(record, 'done', at);
   328	      return {};
   329	    }
   330	
   331	    if (order.verb === 'SECURE_CHOICE') {
   332	      this.status(record, 'active', at);
   333	      const result = this.secureChoice?.(order.choice) ?? { ok: false as const, reason: 'SECURE_CHOICE is unavailable.' };
   334	      if (result.ok) this.status(record, 'done', at);
   335	      else this.fail(record, result.reason, at);
   336	      return {};
   337	    }
   338	

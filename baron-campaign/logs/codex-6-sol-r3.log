   997	  private updateBaronRocketVolley(): void {
   998	    const config = this.manifest.twist.baron?.rocketVolley;
   999	    const baron = config
  1000	      ? this.enemies.all.find((enemy) => enemy.isAlive && enemy.eliteKind === 'baron')
  1001	      : undefined;
  1002	    if (!config || !baron || this.baronBeaten) {
  1003	      this.baronRocketTelegraphAt = -1;
  1004	      return;
  1005	    }
  1006	    if (this.baronRocketMeleeSuppressed(baron)) {
  1007	      this.baronRocketTelegraphAt = -1;
  1008	      return;
  1009	    }
  1010	    if (this.baronRocketTelegraphAt >= 0) {
  1011	      if (this.timeAlive - this.baronRocketTelegraphAt < Math.max(0.1, config.telegraphSeconds)) return;
  1012	      const count = THREE.MathUtils.clamp(Math.floor(config.count), 1, 6);
  1013	      const ownerId = `baron_rocket:${baron.id}`;
  1014	      const target = new THREE.Vector3();
  1015	      for (let index = 0; index < count; index += 1) {
  1016	        const rng = createRng(`${this.seed}:baron-rocket:${this.baronRocketVolleys}:${index}`);
  1017	        const angle = (Math.PI * 2 * index) / count + rng.range(-0.24, 0.24);
  1018	        const spread = index === 0 ? 0 : Math.max(0, config.spreadRadius) * rng.range(0.55, 1);
  1019	        target.set(
  1020	          this.baronRocketTarget.x + Math.cos(angle) * spread,
  1021	          this.baronRocketTarget.y,
  1022	          this.baronRocketTarget.z + Math.sin(angle) * spread,
  1023	        );
  1024	        this.combat.launchLob(
  1025	          baron.position,
  1026	          target,
  1027	          Math.max(0.1, config.airTime),
  1028	          Math.max(0, config.damage),
  1029	          Math.max(0.2, config.radius),
  1030	          ownerId,
  1031	        );
  1032	      }
  1033	      this.replayEvents.push({
  1034	        type: 'baron_rocket_volley',
  1035	        at: round(this.timeAlive),
  1036	        volley: this.baronRocketVolleys,
  1037	        count,
  1038	        damage: config.damage,
  1039	        radius: config.radius,
  1040	        target: point(this.baronRocketTarget),
  1041	      });
  1042	      this.baronRocketVolleys += 1;
  1043	      this.baronRocketTelegraphAt = -1;
  1044	      this.baronRocketNextAt = this.timeAlive + Math.max(0.2, config.cadenceSeconds);
  1045	      return;
  1046	    }
  1047	    if (this.timeAlive < this.baronRocketNextAt) return;
  1048	    const building = this.targeting.nearestBuilding(baron.position);
  1049	    const heroRange = Math.max(16, baron.heroPursuitRange || 45);
  1050	    const heroInRange = baron.position.distanceToSquared(this.hero.group.position) <= heroRange * heroRange;
  1051	    this.baronRocketTarget.copy(heroInRange || !building ? this.hero.group.position : building.position);
  1052	    this.baronRocketTelegraphAt = this.timeAlive;
  1053	    this.replayEvents.push({
  1054	      type: 'baron_rocket_telegraph',
  1055	      at: round(this.timeAlive),
  1056	      target: heroInRange || !building ? 'hero' : 'building',
  1057	      position: point(this.baronRocketTarget),
  1058	    });
  1059	  }

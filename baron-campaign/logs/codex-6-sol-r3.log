    21	  build('sluice', 1, SLUICES), build('sluice', 2, SLUICES),
    22	  ...TURRETS.map((_, index) => build('turret', index, TURRETS)),
    23	  build('stockpile', 0, STOCKPILES),
    24	  ...SLUICES.flatMap((_, index) => [upgrade('sluice', index, 1), upgrade('sluice', index, 2)]),
    25	  build('sentry_beacon', 1, BEACONS), build('sentry_beacon', 2, BEACONS),
    26	  ...TURRETS.map((_, index) => upgrade('turret', index, 1)),
    27	  ...TURRETS.map((_, index) => upgrade('turret', index, 2)),
    28	  ...BEACONS.slice(3).map((_, offset) => build('sentry_beacon', offset + 3, BEACONS)),
    29	  build('stockpile', 1, STOCKPILES),
    30	];
    31	
    32	function pickUpgrade(view) {
    33	  const hurt = view.now.hero.hp / Math.max(1, view.now.hero.maxHp) < 0.72;
    34	  const scores = {
    35	    split_spark: 130, heavy_spark: 124, double_tap_coil: 121, long_resonator: 116,
    36	    powder_charge: 113, quick_fuse: 111, beacon_dynamo: 109, chain_spark_arc: 106,
    37	    beacon_handoff: 104, tinkers_plating: view.now.wave >= 16 || hurt ? 145 : 101,
    38	    sharpen: 100, wide_ring: 94, spark_pressure_ring: 92,
    39	    field_dressing: view.now.wave >= 18 || hurt ? 142 : 60,
    40	    prospectors_luck: 52, rich_seam_pact: 48, stockpile_seam_survey: 45,
    41	    pan_legend: 40, assay_bonus: 38, spring_heels: 20, prospector_policy_slot: 5,
    42	  };
    43	  return [...view.now.pendingOffer].sort((a, b) => (scores[b.id] ?? 50) - (scores[a.id] ?? 50))[0];
    44	}
    45	
    46	function atPosition(entry, step) {
    47	  return entry.id === step.id && Math.abs(entry.position.x - step.pos.x) < 0.2 && Math.abs(entry.position.z - step.pos.z) < 0.2;
    48	}
    49	
    50	function nextGoal(view) {
    51	  const palisadeCount = view.now.works.byKind.palisade ?? 0;
    52	  if (view.now.wave >= 19 && palisadeCount < PALISADES.length) {
    53	    const pos = PALISADES[palisadeCount];
    54	    return { cost: COSTS.palisade, pos, order: { verb: 'BUILD', what: 'palisade', where: pos, when: { goldGte: COSTS.palisade } } };
    55	  }
    56	  if (view.now.wave >= 19) return null;
    57	
    58	  const entries = view.now.works.entries;
    59	  const step = PLAN.find((candidate) => candidate.type === 'build'
    60	    ? !entries.some((entry) => atPosition(entry, candidate))
    61	    : entries.some((entry) => entry.id === candidate.id && entry.index === candidate.index && entry.tier === candidate.fromTier));
    62	  if (!step) return null;
    63	  if (step.type === 'build') return { cost: step.cost, pos: step.pos, order: { verb: 'BUILD', what: step.id, where: step.pos, when: { goldGte: step.cost } } };
    64	  const entry = entries.find((candidate) => candidate.id === step.id && candidate.index === step.index);
    65	  return entry ? { cost: step.cost, pos: entry.position, order: { verb: 'CONTEXT_ACTION', action: 'upgrade', target: { id: step.id, index: step.index } } } : null;
    66	}
    67	
    68	function blastOrders(view, boss = false) {
    69	  if (view.now.threats.alive === 0) return [{ verb: 'SET_WEAPON', weapon: 'rig' }];
    70	  const edge = view.now.threats.edge;
    71	  const pos = boss ? { x: 0, z: 11 }
    72	    : edge === 'north' ? { x: 0, z: 20 }
    73	      : edge === 'south' ? { x: 0, z: 4 }
    74	        : edge === 'east' ? { x: 8, z: 12 }
    75	          : edge === 'west' ? { x: -8, z: 12 }
    76	            : { x: 0, z: 9 };
    77	  const waits = Math.min(26, Math.max(0, Math.ceil(view.now.blastReadyInMs / (1000 / 30)) - 1));
    78	  return [
    79	    ...Array.from({ length: waits }, () => ({ verb: 'SET_WEAPON', weapon: 'rig' })),
    80	    { verb: 'BLAST_AT', pos },
    81	    { verb: 'BLAST_AT', pos },
    82	  ];
    83	}
    84	
    85	function moneyOrders(view) {
    86	  if (view.now.gold >= 480) return [];
    87	  const locations = new Map(view.stablePrefix.map.seams.map((seam) => [seam.id, seam]));
    88	  const prospector = view.now.prospector ?? HOLD;
    89	  const seam = view.now.seams.filter(({ active, remaining }) => active && remaining > 0).sort((a, b) => {
    90	    const left = locations.get(a.id);
    91	    const right = locations.get(b.id);
    92	    return Math.hypot((left?.x ?? 999) - prospector.x, (left?.z ?? 999) - prospector.z)
    93	      - Math.hypot((right?.x ?? 999) - prospector.x, (right?.z ?? 999) - prospector.z);
    94	  })[0];
    95	  return seam ? Array.from({ length: Math.min(12, Math.ceil(seam.remaining / 5) + 1) }, () => ({ verb: 'HARVEST', seam: seam.id })) : [];
    96	}
    97	
    98	function repairCost(entry) {
    99	  if (entry.id === 'sluice') return Math.ceil((40 + (entry.tier >= 2 ? 120 : 0) + (entry.tier >= 3 ? 240 : 0)) * 0.25);
   100	  if (entry.id === 'turret') return Math.ceil(((COSTS.turret[entry.index] ?? 50) + (entry.tier >= 2 ? 150 : 0) + (entry.tier >= 3 ? 300 : 0)) * 0.25);
   101	  if (entry.id === 'sentry_beacon') return Math.ceil((COSTS.sentry_beacon[entry.index] ?? 25) * 0.25);
   102	  return 15;
   103	}
   104	
   105	function ordersFor(view) {
   106	  if (view.now.pendingSecure) return [{ verb: 'SECURE_CHOICE', choice: 'bank' }];
   107	  const prefix = view.now.pendingOffer?.length ? [{ verb: 'PICK_UPGRADE', id: pickUpgrade(view).id }] : [];
   108	  const entries = view.now.works.entries;
   109	
   110	  if (view.now.wave >= 19) {
   111	    const goal = nextGoal(view);
   112	    if (goal) {
   113	      if (view.now.gold >= goal.cost) return [...prefix, { verb: 'MOVE_TO', pos: goal.pos }, goal.order, ...blastOrders(view)].slice(0, 32);
   114	      const harvest = moneyOrders(view);
   115	      if (harvest.length) return [...prefix, ...harvest].slice(0, 32);
   116	    }
   117	    const centerDamaged = entries.some(({ id, index, hp, maxHp, wrecked }) => id === 'palisade' && index === 0 && (wrecked || hp / maxHp < 0.31));
   118	    if (centerDamaged) return [...prefix, { verb: 'REPAIR_UNDER', pct: 31 }, ...blastOrders(view, true)].slice(0, 32);
   119	    return [...prefix, ...blastOrders(view, true), { verb: 'HOLD', pos: HOLD }].slice(0, 32);
   120	  }
   121	
   122	  const wrecked = entries.find((entry) => entry.wrecked && entry.id !== 'palisade');
   123	  if (wrecked) {
   124	    const harvest = moneyOrders(view);
   125	    if (view.now.gold >= repairCost(wrecked)) return [...prefix, { verb: 'REPAIR_UNDER', pct: 1 }, ...blastOrders(view)].slice(0, 32);
   126	    if (harvest.length) return [...prefix, ...harvest].slice(0, 32);
   127	  }
   128	
   129	  const goal = nextGoal(view);
   130	  if (goal && view.now.gold >= goal.cost) return [...prefix, { verb: 'MOVE_TO', pos: goal.pos }, goal.order, ...blastOrders(view)].slice(0, 32);
   131	  const harvest = moneyOrders(view);
   132	  if (harvest.length) return [...prefix, ...harvest].slice(0, 32);
   133	  return [...prefix, ...blastOrders(view)].slice(0, 32);
   134	}
   135	
   136	function selfCheck() {
   137	  const choice = pickUpgrade({ now: { wave: 10, hero: { hp: 100, maxHp: 100 }, pendingOffer: [{ id: 'spring_heels' }, { id: 'heavy_spark' }] } });
   138	  assert.equal(choice.id, 'heavy_spark');
   139	  const orders = blastOrders({ now: { blastReadyInMs: 500, threats: { alive: 1, edge: 'north' } } });
   140	  assert.equal(orders.at(-1).verb, 'BLAST_AT');
   141	  assert(orders.slice(0, -2).every((order) => order.verb === 'SET_WEAPON' && order.weapon === 'rig'));
   142	  assert(orders.length <= 28);
   143	  console.log('player self-check: ok');
   144	}
   145	
   146	if (process.argv.includes('--self-check')) {
   147	  selfCheck();
   148	  process.exit(0);
   149	}
   150	
   151	const run = Number(process.argv[2] ?? 1);
   152	if (!Number.isInteger(run) || run < 1 || run > 6) throw new Error('run must be an integer from 1 to 6');
   153	
   154	const tapePath = `run-${run}-tape.json`;
   155	const transcript = createWriteStream(new URL(`run-${run}.jsonl`, ROOT));
   156	const errors = createWriteStream(new URL(`run-${run}.stderr.log`, ROOT));
   157	const child = spawn(process.execPath, ['scripts/gr-sim.mjs', '--contract', 'e1-baron', '--seed', 'e1-baron-01', '--tape', tapePath], {
   158	  cwd: ROOT,
   159	  stdio: ['pipe', 'pipe', 'pipe'],
   160	});
   161	
   162	let buffer = '';
   163	let outcome;
   164	child.stdout.on('data', (chunk) => {
   165	  buffer += chunk;
   166	  let newline;
   167	  while ((newline = buffer.indexOf('\n')) >= 0) {
   168	    const line = buffer.slice(0, newline);
   169	    buffer = buffer.slice(newline + 1);
   170	    if (!line) continue;
   171	    const message = JSON.parse(line);
   172	    if (message.schema === 'goldrush.view.v1') {
   173	      const orders = ordersFor(message);
   174	      transcript.write(`${JSON.stringify({ type: 'turn', wave: message.now.wave, gold: message.now.gold, hero: message.now.hero, threats: message.now.threats, works: message.now.works, orders })}\n`);
   175	      child.stdin.write(`${JSON.stringify(orders)}\n`);
   176	    } else {
   177	      outcome = message;
   178	      transcript.write(`${JSON.stringify({ type: 'outcome', outcome: message })}\n`);
   179	    }
   180	  }
   181	});
   182	child.stderr.pipe(errors);
   183	
   184	child.on('close', async (code) => {
   185	  transcript.end();
   186	  errors.end();
   187	  if (code !== 0 || !outcome) {
   188	    console.error(`gr-sim exited ${code} without an outcome`);
   189	    process.exitCode = 1;
   190	    return;
   191	  }
   192	  const result = { ...outcome, runsSoFar: run, player: 'player.mjs', tape: tapePath };
   193	  const temporary = new URL('outcome.json.tmp', ROOT);
   194	  await writeFile(temporary, `${JSON.stringify(result, null, 2)}\n`);
   195	  await rename(temporary, new URL('outcome.json', ROOT));
   196	  console.log(JSON.stringify(result));
   197	});

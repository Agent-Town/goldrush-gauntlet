  BUILD_STEP(SLUICES[1]),
  BUILD_STEP(SLUICES[2]),
  ...TURRETS.map(BUILD_STEP),
  BUILD_STEP(STOCKPILES[0]),
  UPGRADE_STEP('sluice', 0, 1, 120),

+
+function blastOrders(view, boss = false) {
+  if (view.now.threats.alive === 0) return [{ verb: 'SET_WEAPON', weapon: 'rig' }];
+  const edge = view.now.threats.edge;
+  const pos = boss ? { x: 0, z: 11 }
+    : edge === 'north' ? { x: 0, z: 20 }
+      : edge === 'south' ? { x: 0, z: 4 }
+        : edge === 'east' ? { x: 8, z: 12 }
+          : edge === 'west' ? { x: -8, z: 12 }

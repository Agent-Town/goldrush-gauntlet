+      : edge === 'south' ? { x: 0, z: 4 }
+        : edge === 'east' ? { x: 8, z: 12 }
+          : edge === 'west' ? { x: -8, z: 12 }
+            : { x: 0, z: 9 };
+  const waits = Math.min(26, Math.max(0, Math.ceil(view.now.blastReadyInMs / (1000 / 30)) - 1));
+  return [
+    ...Array.from({ length: waits }, () => ({ verb: 'SET_WEAPON', weapon: 'rig' })),
+    { verb: 'BLAST_AT', pos },

  1474	  private blastAt(pos: { x: number; z: number }): { ok: true } | { ok: false; reason: string } {
  1475	    const readyInMs = this.blastReadyInMs();
  1476	    if (readyInMs > 0) return { ok: false, reason: `COOLDOWN: Blast Charge ready in ${readyInMs}ms.` };
  1477	    const origin = this.hero.group.position;
  1478	    if (Math.hypot(pos.x - origin.x, pos.z - origin.z) > Balance.blast.range) {
  1479	      return { ok: false, reason: `OUT_OF_RANGE: BLAST_AT must be within ${Balance.blast.range}m of the hero.` };
  1480	    }
  1481	    const stats = this.progression.stats;
  1482	    const waveMult = 1 + Math.max(0, this.waves.diagnostics.wave) * Balance.blast.dmgPerWave;
  1483	    const launched = this.combat.launchLob(
  1484	      origin,
  1485	      new THREE.Vector3(pos.x, Balance.enemy.groundY, pos.z),
  1486	      Balance.blast.airTime,
  1487	      Balance.blast.damage * stats.blastDamageMult * waveMult,
  1488	      Balance.blast.radius * stats.blastRadiusMult,
  1489	      'hero_blast',
  1490	    );
  1491	    if (!launched) return { ok: false, reason: 'BLAST_POOL_FULL: no blast charge slot is available.' };
  1492	    const combat = this.combat.captureSuspend();
  1493	    const shooter = combat.shooters.find(({ resumeKey }) => resumeKey === this.blastShooter.resumeKey);
  1494	    if (!shooter) throw new Error('Blast Charge shooter is not registered.');
  1495	    shooter.timer = this.blastShooter.cooldown;
  1496	    if (!this.combat.restoreSuspend(combat)) throw new Error('Blast Charge cooldown could not be restored.');
  1497	    this.replayEvents.push({ type: 'blast_at', at: round(this.timeAlive), pos: point(pos) });
  1498	    return { ok: true };
  1499	  }

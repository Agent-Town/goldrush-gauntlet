   200	export type UpgradeId = string;
   201	export type ResolvedFiller = { goldGrant?: number; heal?: number; effectText: string };
   202	
   203	export const upgradeDefById: Record<string, UpgradeDef> = upgradeDefs.reduce(
   204	  (defs, def) => {
   205	    defs[def.id] = def;
   206	    return defs;
   207	  },
   208	  {} as Record<string, UpgradeDef>,
   209	);

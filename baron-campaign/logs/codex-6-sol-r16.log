}

function atomicOutcome(value) {
  const tmp = 'outcome.json.tmp';
  writeFileSync(tmp, `${JSON.stringify({ ...value, runsSoFar: runNumber }, null, 2)}\n`);
  renameSync(tmp, 'outcome.json');
}
function handleLine(raw) {

function atPos(entry, plan) {
  return entry.id === plan.id && Math.abs(entry.position.x - plan.pos.x) < 0.2 && Math.abs(entry.position.z - plan.pos.z) < 0.2;
}
function buildOrders(plan) {
  return [
    { verb: 'MOVE_TO', pos: plan.pos },

const fs=require('fs');const xs=fs.readFileSync('run-1.jsonl','utf8').trim().split('\\n').map(JSON.parse);const last=xs.at(-1);const swaps=xs.filter(x=>x.orders?.some(o=>o.verb==='CONTEXT_ACTION'&&o.action==='demolish')).length;console.log({lines:xs.length,wave:last.wave,timeMs:last.timeMs,gold:last.gold,hp:last.hero?.hp,alive:last.threats?.alive,swaps});

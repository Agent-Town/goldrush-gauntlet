+  return entry ? { cost: step.cost, pos: entry.position, order: { verb: 'CONTEXT_ACTION', action: 'upgrade', target: { id: step.id, index: step.index } } } : null;
+}
+
+function combatOrders(view, boss = false) {
+  if (view.now.threats.alive === 0) return [{ verb: 'SET_WEAPON', weapon: 'rig' }, { verb: 'HOLD', pos: HOLD }];
+  const edge = view.now.threats.edge;
+  const pos = boss ? PALISADES[0]
+    : edge === 'north' ? { x: 0, z: 20 }
+      : edge === 'south' ? { x: 0, z: 4 }
+        : edge === 'east' ? { x: 8, z: 12 }
+          : edge === 'west' ? { x: -8, z: 12 }
+            : { x: 0, z: 9 };
+  const waitTicks = Math.min(boss ? 10 : 26, Math.max(0, Math.ceil(view.now.blastReadyInMs / (1000 / 30))));
+  const wait = Array.from({ length: waitTicks }, () => ({ verb: 'SET_WEAPON', weapon: 'rig' }));
+  const blast = { verb: 'BLAST_AT', pos };

+  const harvest = moneyOrders(view);
+  if (harvest.length) return [...prefix, ...harvest].slice(0, 32);
+  return [...prefix, ...combatOrders(view)].slice(0, 32);
+}
+
+function selfCheck() {
+  const view = { now: { wave: 20, blastReadyInMs: 500, hero: { hp: 100, maxHp: 100 }, threats: { alive: 1, edge: 'north' }, pendingOffer: [{ id: 'spring_heels' }, { id: 'heavy_spark' }] } };
+  assert.equal(pickUpgrade(view).id, 'heavy_spark');
+  assert.equal(combatOrders(view, true).filter(({ verb }) => verb === 'SET_WEAPON').length, 10);
+  assert.deepEqual(combatOrders(view, true).find(({ verb }) => verb === 'BLAST_AT').pos, PALISADES[0]);
+  console.log('player self-check: ok');
+}
+

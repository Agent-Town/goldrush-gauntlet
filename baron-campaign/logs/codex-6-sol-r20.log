+const errors = createWriteStream(new URL(`run-${run}.stderr.log`, ROOT));
+const child = spawn(process.execPath, ['scripts/gr-sim.mjs', '--contract', 'e1-baron', '--seed', 'e1-baron-01', '--tape', tapePath], { cwd: ROOT, stdio: ['pipe', 'pipe', 'pipe'] });
+let buffer = '';
+let outcome;
+
+child.stdout.on('data', (chunk) => {
+  buffer += chunk;

+
+function pickUpgrade(view) {
+  const hpRatio = view.now.hero.hp / Math.max(1, view.now.hero.maxHp);
+  const scores = {
+    split_spark: 130, heavy_spark: 124, double_tap_coil: 121, long_resonator: 116,

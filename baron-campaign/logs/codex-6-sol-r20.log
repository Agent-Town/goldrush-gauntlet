let outcome = null;

const SLUICES = [
  { id: 'sluice', pos: { x: -10, z: 7 }, cost: 40 },
  { id: 'sluice', pos: { x: -6, z: 7 }, cost: 40 },
  { id: 'sluice', pos: { x: -2, z: 7 }, cost: 40 },
];
const TURRETS = [
  { id: 'turret', pos: { x: -6, z: 12 }, cost: 50 },

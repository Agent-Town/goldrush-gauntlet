+    return pos ? { cost: 10, pos, order: { verb: 'BUILD', what: 'palisade', where: pos, when: { goldGte: 10 } } } : null;
+  }
+  const step = PLAN.find((candidate) => candidate.type === 'build'
+    ? !entries.some((entry) => atPosition(entry, candidate))

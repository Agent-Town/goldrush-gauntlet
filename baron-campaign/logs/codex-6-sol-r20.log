+    sharpen: 100, wide_ring: 94, spark_pressure_ring: 92,
+    field_dressing: view.now.wave >= 18 || hpRatio < 0.72 ? 142 : 60,
+    prospectors_luck: 52, rich_seam_pact: 48, stockpile_seam_survey: 45,

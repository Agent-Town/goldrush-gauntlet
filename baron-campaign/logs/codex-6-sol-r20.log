+  if (view.now.wave >= 19) {
+    const pos = PALISADES.find((candidate) => !entries.some((entry) => entry.id === 'palisade' && Math.abs(entry.position.x - candidate.x) < 0.2 && Math.abs(entry.position.z - candidate.z) < 0.2));
+    return pos ? { cost: 10, pos, order: { verb: 'BUILD', what: 'palisade', where: pos, when: { goldGte: 10 } } } : null;

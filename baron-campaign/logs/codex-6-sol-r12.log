node player.mjs --self-check
jq -e '.secured == true and .waves == 22 and .gold == 389 and .calls == 506 and .runsSoFar == 3 and .eventLogHash == \"fnv1a32:2f552f97\"' outcome.json >/dev/null
jq -e '.contract == \"e1-baron\" and .seed == \"e1-baron-01\" and .outcome.secured == true and .outcome.waves == 22 and .outcome.gold == 389 and (.inputLog.entries | length) == 506' run-3-tape.json >/dev/null
if rg -n \"rejected|gr-sim exited|Error:\" run-3.stderr.log; then exit 1; fi
ls -lh player.mjs attempt.md outcome.json run-3-tape.json run-3.jsonl run-3.stderr.log

+    { verb: 'BLAST_AT', pos },
+    { verb: 'BLAST_AT', pos },
+  ];
+}
+
+function moneyOrders(view) {
+  if (view.now.gold >= 480) return [];
+  const map = new Map(view.stablePrefix.map.seams.map((seam) => [seam.id, seam]));
+  const prospector = view.now.prospector ?? HOLD;
